# Copy to .env and choose a long shared password before starting.
APP_PASSWORD=
# Set this to the image you publish to your registry for pull-based updates.
IMAGE=yealink-directory:latest
PORT=8080
# Optionally restrict the listener to the mini PC's LAN address.
BIND_IP=0.0.0.0
# Set to 1 only when serving through a local HTTPS reverse proxy.
COOKIE_SECURE=0
